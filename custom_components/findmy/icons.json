{
  "entity": {
    "binary_sensor": {
      "battery_low": {
        "default": "mdi:battery-check",
        "state": {
          "on": "mdi:battery-alert"
        }
      },
      "charging": {
        "default": "mdi:battery",
        "state": {
          "on": "mdi:battery-charging"
        }
      },
      "lost": {
        "default": "mdi:lock-open-variant-outline",
        "state": {
          "on": "mdi:cellphone-lock"
        }
      },
      "fetch_problem": {
        "default": "mdi:cloud-check-outline",
        "state": {
          "on": "mdi:cloud-alert"
        }
      }
    },
    "button": {
      "play_sound": {
        "default": "mdi:volume-high"
      },
      "refresh": {
        "default": "mdi:refresh"
      }
    },
    "device_tracker": {
      "location": {
        "default": "mdi:radar"
      }
    },
    "sensor": {
      "battery": {
        "default": "mdi:battery",
        "range": {
          "0": "mdi:battery-outline",
          "10": "mdi:battery-10",
          "20": "mdi:battery-20",
          "30": "mdi:battery-30",
          "40": "mdi:battery-40",
          "50": "mdi:battery-50",
          "60": "mdi:battery-60",
          "70": "mdi:battery-70",
          "80": "mdi:battery-80",
          "90": "mdi:battery-90",
          "100": "mdi:battery"
        }
      },
      "battery_state": {
        "default": "mdi:battery",
        "state": {
          "full": "mdi:battery",
          "medium": "mdi:battery-50",
          "low": "mdi:battery-20",
          "critical": "mdi:battery-alert-variant-outline"
        }
      },
      "last_seen": {
        "default": "mdi:map-clock-outline"
      },
      "status": {
        "default": "mdi:help-circle-outline",
        "state": {
          "online": "mdi:cloud-check-outline",
          "offline": "mdi:cloud-off-outline",
          "pending": "mdi:cloud-clock-outline",
          "unregistered": "mdi:cloud-cancel"
        }
      },
      "last_fetch": {
        "default": "mdi:cloud-sync-outline"
      }
    }
  },
  "services": {
    "play_sound": {
      "service": "mdi:volume-high"
    },
    "display_message": {
      "service": "mdi:message-text-outline"
    },
    "lost_mode": {
      "service": "mdi:cellphone-lock"
    },
    "refresh": {
      "service": "mdi:refresh"
    }
  }
}
